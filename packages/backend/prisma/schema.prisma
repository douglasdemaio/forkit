generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id            String     @id @default(cuid())
  walletAddress String     @unique
  name          String
  metadata      Json       @default("{}")
  acceptedMints String[]   @default([])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  menuItems MenuItem[]
  orders    Order[]
}

model MenuItem {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String   @default("")
  price        Decimal  @db.Decimal(12, 6)
  imageCid     String   @default("")
  category     String   @default("")
  available    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
}

model Customer {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]
}

model Driver {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  metadata      Json     @default("{}")
  zones         Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]
}

model Order {
  id              String   @id @default(cuid())
  onChainOrderId  BigInt   @unique
  customerId      String
  restaurantId    String
  driverId        String?
  items           Json
  tokenMint       String
  foodTotal       Decimal  @db.Decimal(12, 6)
  deliveryFee     Decimal  @db.Decimal(12, 6)
  protocolFee     Int
  depositAmount   Int
  escrowTarget    Decimal  @db.Decimal(12, 6)
  escrowFunded    Decimal  @default(0) @db.Decimal(12, 6)
  status          String   @default("Created")
  codeAHash       String
  codeBHash       String
  shareLink       String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id])
  driver        Driver?        @relation(fields: [driverId], references: [id])
  contributions Contribution[]
}

model Contribution {
  id            String   @id @default(cuid())
  orderId       String
  walletAddress String
  amount        Decimal  @db.Decimal(12, 6)
  txSignature   String
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@unique([orderId, walletAddress])
}
